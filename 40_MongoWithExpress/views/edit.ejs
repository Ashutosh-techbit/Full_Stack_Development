<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit</title>
  </head>
  <body>

    <h3>Edit Chat : <%= chat._id %></h3>
    <p>sender :- <%= chat.from %> reciever :- <%= chat.to%></p>

    <form method="post" action="/chats/<%= chat._id%>?_method=PUT">
      <textarea name="msg" id="msg"><%= chat.msg %></textarea><br>
      <button>Edit</button>
    </form>

  </body>
 </html> 
