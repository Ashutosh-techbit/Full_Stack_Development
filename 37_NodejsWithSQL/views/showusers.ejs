<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ALL users</title>
    <style>
        table,th,td{
            border: 2px solid black;
        }
    </style>
</head>


<body>
    <table>
        <tr>
            <th>ID</th>
            <th>email</th>
            <th>username</th>
        </tr>
        <%for (user of users) {%>
        <tr>
            <td><%= user.id %></td>
            <td><%= user.email %></td>
            <td><%= user.name %></td>
            <td>
                <form action="/user/edit/<%=user.id%>" method="GET">
                    <button>Edit username</button>
                </form>
            </td>
        </tr>
        <%}%>
    </table>
</body>
</html>